# Copie para .env e preencha
PORT=3001
# Senha que os amigos digitam no app
APP_PASSWORD=troque-esta-senha
# Salas fixas que aparecem na barra lateral (separadas por vírgula)
ROOMS=Geral,Jogos,Filmes
# Mesmas chaves do livekit.yaml
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=segredo-longo
# Como o servidor de token fala com o LiveKit (rede interna do docker)
LIVEKIT_HOST=http://livekit:7880
# Endereço público do LiveKit que o app dos amigos vai usar
LIVEKIT_PUBLIC_URL=wss://voz.SEUDOMINIO.com.br
